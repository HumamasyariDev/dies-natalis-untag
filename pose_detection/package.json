{
  "name": "mediapipe-pose",
  "version": "0.1.0",
  "description": "Clean, modular wrapper around MediaPipe Pose Landmarker for real-time body tracking",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "download-models": "node scripts/downloadModels.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@vitest/coverage-v8": "^1.6.0",
    "jsdom": "^24.0.0",
    "vitest": "^1.6.0"
  },
  "keywords": [
    "mediapipe",
    "pose-detection",
    "pose-landmarker",
    "body-tracking"
  ],
  "author": "berad217",
  "license": "MIT"
}
